#!/bin/sh
# Builds wolfSSL for the PSP from the submodule in wolfssl/ into build/wolfssl.
# Inside the pspdev container, from the repository root:
#
#   docker run --rm -v "$PWD:/src" -w /src pspdev/pspdev:latest sh tools/build-wolfssl
#
# To move to another wolfSSL, pin the submodule to its tag and run this again:
#
#   git -C wolfssl fetch --depth 1 origin tag v5.9.2-stable
#   git -C wolfssl checkout v5.9.2-stable
#
# Started from the wolfssl PSPBUILD in pspdev's psp-packages: the same
# toolchain file and cmake options. The departures are build flags; the
# source is upstream's, untouched:
#
#   CUSTOM_RAND_     Makes wc_GenerateSeed() call pspkit_https_seed(), which
#   GENERATE_SEED    src/entropy.c provides, so the /dev/urandom branch --
#                    which the PSP does not have, and which makes
#                    wolfCrypt_Init() die with WC_INIT_E (-228) -- is never
#                    compiled in. The runtime hook wc_SetSeed_Cb() cannot be
#                    used for this: wolfSSL_Init() overwrites it with
#                    wc_GenerateSeed again before anything of ours can take
#                    effect.
#
#   ALT_CERT_        Trust the chain as soon as a certificate in it is one we
#   CHAINS           already hold, instead of insisting that every certificate
#                    above it also verifies. Public CAs cross-sign: GitHub
#                    Pages sends a chain that ends in a Let's Encrypt root
#                    cross-signed by ISRG, and verifying that last signature
#                    fails with ASN_SIG_CONFIRM_E (-155) even though ISRG Root
#                    X1 is right there among the roots.
#
#   SP_INT_BITS      The big-integer backend sizes itself from what is compiled
#   4096             in, and with only RSA and no large FFDHE parameters it
#                    settles on 3072 bits. Every RSA-4096 signature then fails
#                    to verify with ASN_SIG_CONFIRM_E (-155) -- including the
#                    one ISRG Root X1 puts on the chain GitHub Pages serves. A
#                    size limit that presents itself as a forged certificate is
#                    the worst kind.
#
#   WOLFSSL_USER_IO  src/https.c supplies the socket callbacks, since the SDK's
#                    BSD wrappers do not work, so wolfSSL's EmbedSend and
#                    EmbedReceive are left out. That also keeps out the IPv6
#                    alt-name matcher, which wants a struct sockaddr_in6 the
#                    PSP headers do not have.
#
#   CURVE25519 &c.   X25519 costs a fraction of P-256 on a core with no crypto
#                    hardware -- five key exchanges, 154 ms against 1032 ms.
#                    Ed25519 is for signatures, ChaCha20-Poly1305 for bulk
#                    without AES acceleration.
set -e

KIT="$(cd "$(dirname "$0")/.." && pwd)"
SRC="$KIT/wolfssl"
OUT="$KIT/build/wolfssl"
WORK="$KIT/build/wolfssl-cmake"
[ -f "$SRC/CMakeLists.txt" ] || {
	echo "wolfssl/ is empty: git submodule update --init" >&2
	exit 1
}

# The departures above, as the compiler sees them. One list, because the
# application has to be shown the same one: see the end of this script.
DEFS="NO_WRITEV NO_DEV_RANDOM WOLFSSL_USER_IO SP_INT_BITS=4096 WOLFSSL_ALT_CERT_CHAINS CUSTOM_RAND_GENERATE_SEED=pspkit_https_seed"
CFLAGS="${EXTRA_CFLAGS:-} -include $KIT/src/wolfssl_seed.h"
for d in $DEFS; do CFLAGS="$CFLAGS -D$d"; done

rm -rf "$WORK" "$OUT"
CFLAGS="$CFLAGS" cmake -Wno-dev -S "$SRC" -B "$WORK" \
	-DCMAKE_TOOLCHAIN_FILE="$PSPDEV/psp/share/pspdev.cmake" \
	-DCMAKE_INSTALL_PREFIX="$OUT" \
	-DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF \
	-DWOLFSSL_CRYPT_TESTS=OFF -DWOLFSSL_EXAMPLES=OFF \
	-DWOLFSSL_CURL=ON \
	-DWOLFSSL_CURVE25519=yes -DWOLFSSL_ED25519=yes \
	-DWOLFSSL_CHACHA=yes -DWOLFSSL_POLY1305=yes \
	-DWARNING_C_FLAGS=-w >/dev/null
cmake --build "$WORK" -j"$(nproc)"
cmake --install "$WORK" >/dev/null
rm -rf "$WORK"

# options.h is the library's account of how it was built, and the application
# compiles against it. cmake fills it from a fixed template of known options,
# and ours fall through. Without SP_INT_BITS there the application would size
# big integers differently from the library it links, so the list goes in
# by hand, before the closing extern "C".
OPTS="$OUT/include/wolfssl/options.h"
FRAG=""
for d in $DEFS; do
	FRAG="$FRAG#undef  ${d%%=*}
#define $(echo "$d" | tr '=' ' ')
"
done
awk -v frag="$FRAG" '
	{ line[NR] = $0; if ($0 ~ /^#ifdef __cplusplus/) last = NR }
	END { for (i = 1; i <= NR; i++) { if (i == last) print frag; print line[i] } }
' "$OPTS" >"$OPTS.tmp" && mv "$OPTS.tmp" "$OPTS"

for d in WOLFSSL_TLS13 HAVE_CURVE25519 HAVE_ED25519 HAVE_CHACHA WOLFSSL_ALT_CERT_CHAINS SP_INT_BITS WOLFSSL_USER_IO; do
	grep -qE "^#define $d" "$OPTS" && echo "  on   $d" || { echo "  OFF  $d" >&2; exit 1; }
done
echo "wolfSSL $(git -C "$SRC" describe --tags 2>/dev/null || echo '?') -> build/wolfssl"
