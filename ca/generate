#!/usr/bin/env python3
"""Writes src/ca_bundle.h: every root in ca/cacert.pem as DER, in one table.

ca/cacert.pem is Mozilla's root store as curl publishes it, taken whole: a
library that reaches only the hosts somebody thought of is a strange library.
The PEM is decoded here rather than on the console, so the PSP skips the
base64 and parses each root once per run, straight from the table.

The file is checked against ca/cacert.pem.sha256 first, so a bundle edited by
hand or cut short by a download never becomes a header. ca/update fetches a
newer one.

    ca/generate
"""

import base64
import hashlib
import re
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
PEM = HERE / "cacert.pem"
PIN = HERE / "cacert.pem.sha256"
OUT = HERE.parent / "src" / "ca_bundle.h"

data = PEM.read_bytes()
digest = hashlib.sha256(data).hexdigest()
pinned = PIN.read_text().split()[0]
if digest != pinned:
    sys.exit(f"{PEM.name} is {digest}, the pin says {pinned}: refusing")

text = data.decode("utf-8")
dated = re.search(r"^## Certificate data from Mozilla as of: (.+)$", text, re.M)
blocks = re.findall(r"([^\n]+)\n=+\n-----BEGIN CERTIFICATE-----\n(.*?)-----END CERTIFICATE-----", text, re.S)
if len(blocks) != text.count("-----BEGIN CERTIFICATE-----"):
    sys.exit("a certificate without a name above it: the format changed")

roots, offsets, blob = [], [], bytearray()
for name, body in blocks:
    der = base64.b64decode("".join(body.split()))
    if der[0] != 0x30:
        sys.exit(f"{name}: not DER after decoding")
    offsets.append(len(blob))
    roots.append(name.strip())
    blob += der
offsets.append(len(blob))

lines = [
    "/* Generated by ca/generate. Do not edit.",
    " *",
    f" * Mozilla's root store as curl publishes it ({dated.group(1) if dated else 'undated'}),",
    f" * {len(roots)} roots as DER. ca/cacert.pem, sha256 {digest[:16]}...",
    " */",
    "#ifndef PSPKIT_HTTPS_CA_BUNDLE_H",
    "#define PSPKIT_HTTPS_CA_BUNDLE_H",
    "",
    f"#define PSPKIT_HTTPS_CA_COUNT {len(roots)}",
    "",
    "static const unsigned char PSPKIT_HTTPS_CA_DER[] = {",
]
for i in range(0, len(blob), 16):
    lines.append("    " + ", ".join(f"0x{b:02x}" for b in blob[i:i + 16]) + ",")
lines.append("};")
lines.append("")
lines.append("static const unsigned int PSPKIT_HTTPS_CA_OFFSETS[PSPKIT_HTTPS_CA_COUNT + 1] = {")
for off, name in zip(offsets, roots + ["end"]):
    lines.append(f"    {off},{' ' * max(1, 8 - len(str(off)))}/* {name.replace('*/', '* /')} */")
lines.append("};")
lines.append("")
lines.append("#endif")
lines.append("")
OUT.write_text("\n".join(lines))
print(f"{len(roots)} roots, {len(blob)} bytes of DER -> {OUT.relative_to(HERE.parent)}")
